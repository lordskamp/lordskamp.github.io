{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dovzhyna-hvyli",
  "main": "api/hvylia-worker.js",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./outputs/hvylia-site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/"
    ],
    "html_handling": "force-trailing-slash"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "WaveRoom"
      },
      {
        "name": "HVYLIA_ACCOUNTS",
        "class_name": "WaveAccountDO"
      },
      {
        "name": "HVYLIA_LEADERBOARD",
        "class_name": "WaveLeaderboardDO"
      },
      {
        "name": "HVYLIA_LOGINS",
        "class_name": "WaveLoginDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WaveRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "WaveAccountDO",
        "WaveLeaderboardDO"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "WaveLoginDO"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "SITE_ORIGIN": "https://lordskamp.github.io",
    "ROOM_TTL_MS": "86400000",
    "HVYLIA_BOT_USERNAME": "DovzhynaHvyli_bot",
    "HVYLIA_APP_URL": "https://dovzhyna-hvyli.lordskamp.workers.dev/hvylia/",
    "HVYLIA_PAYMENT_SUPPORT": "@Lordskamp"
  }
}
