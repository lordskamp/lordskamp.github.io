{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zavod-data",
  "main": "api/zavod-worker.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ALLOWED_ORIGINS": "https://lordskamp.github.io",
    "OWNER_USERNAME": "Lordskamp"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "zavod-data", "migrations_dir": "migrations/zavod" }
  ]
}
